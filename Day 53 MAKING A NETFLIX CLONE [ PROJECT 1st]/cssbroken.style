.eng {
  /* margin: 10px; */
  border-radius: 5px;
  padding: 10px;
}
.signin {
  border-radius: 5px;
  padding: 10px;
}
.default-ltr-cache-4z3qvp {
  text-align: center;
  gap: 10px;
}
.hero > :first-child {
  font-family: "Roboto", sans-serif;
  font-optical-sizing: auto;
  font-weight: weight;
  font-style: normal;
  font-variation-settings: "wdth" 100;
  font-size: 50px;
  text-align: center;
  max-width: 71vw;
}
.hero > :nth-child(2) {
  font-size: 2rem;
  text-align: center;
  
}
.hero > :nth-child(3) {
    text-align: center;
  font-size: 1.54rem;
}
.separation {
  width: 100%;
  background-color: grey;
  height: 2vh;
}
